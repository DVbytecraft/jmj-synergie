# JMJ Synergie - production environment template
# Copy this file to your secret environment store or to a non-versioned .env
# and replace every placeholder before deployment.

# App
ENVIRONMENT=production
APP_NAME=JMJ Synergie
APP_VERSION=1.0.0

# PostgreSQL
POSTGRES_DB=jmj
POSTGRES_USER=jmj_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://jmj_admin:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/jmj

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# JWT / auth
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URLs
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=/api/v1
ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com,www.app.example.com

# Storage
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=10

# Branding / company identity for PDFs
COMPANY_NAME=JMJ Synergie
COMPANY_ADDRESS=Lome, Togo
COMPANY_CITY=Lome
COMPANY_COUNTRY=Togo
COMPANY_PHONE=REPLACE_WITH_JMJ_PHONE
COMPANY_EMAIL=REPLACE_WITH_JMJ_EMAIL
COMPANY_TAX_ID=1001701669
COMPANY_LOGO_PATH=/app/storage/assets/logo.png
COMPANY_STAMP_PATH=/app/storage/assets/stamp.png

# Currency
PREFERRED_CURRENCY=XOF

# Cloudinary - recommended on Render because local filesystem is ephemeral
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=true

# Monitoring / observability
SENTRY_DSN=
METRICS_TOKEN=REPLACE_WITH_METRICS_TOKEN
METRICS_ALLOWED_IPS=

# Initial admin - single login for JMJ Synergie
ADMIN_EMAIL=REPLACE_WITH_MAIN_LOGIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD
ADMIN_NAME=Administrateur JMJ Synergie
