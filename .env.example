# ─────────────────────────────────────────────
#  BILOZ — Environment Variables
# ─────────────────────────────────────────────

# App
ENVIRONMENT=production
APP_NAME="Biloz"
APP_VERSION=1.0.0

# PostgreSQL
POSTGRES_DB=biloz
POSTGRES_USER=biloz_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT Security
SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MINIMUM_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET

# CORS
ALLOWED_ORIGINS=https://yourdomain.com

# Storage
MAX_FILE_SIZE_MB=10

# Email — Brevo (prioritaire) ou SMTP fallback
# Brevo : récupérez votre clé sur https://app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME="Biloz"

# SMTP (utilisé uniquement si BREVO_API_KEY est vide)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@yourdomain.com

# Cloudinary (stockage assets logo/cachet/signature + documents scannés)
# Récupérez sur https://console.cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
USE_CLOUDINARY=false

# Anthropic Claude (OCR facture par IA — optionnel, améliore l'extraction)
# Récupérez sur https://console.anthropic.com/api-keys
# Google Gemini Flash (OCR IA factures — GRATUIT 1500 req/jour)
# Récupérez sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Anthropic Claude (OCR alternatif — optionnel, payant)
# Récupérez sur https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Company (PDF headers)
COMPANY_NAME="Biloz"
COMPANY_ADDRESS="Votre adresse complète"
COMPANY_PHONE="+00 000 000 000"
COMPANY_EMAIL=contact@yourdomain.com
COMPANY_LOGO_PATH=/app/storage/assets/logo.png
COMPANY_STAMP_PATH=/app/storage/assets/stamp.png

# Monitoring
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ── Dev overrides (docker-compose.dev.yml uniquement) ────────────────────────
# Pour le dev, API accessible directement sur le port 8001
DEV_BACKEND_PORT=8001
DEV_FRONTEND_PORT=3001
DEV_NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
DEV_NEXTAUTH_URL=http://localhost:3001
