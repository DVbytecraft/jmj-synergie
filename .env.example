# ─────────────────────────────────────────────
#  JMJ SYNERGIE — Environment Variables
# ─────────────────────────────────────────────

# App
ENVIRONMENT=production
APP_NAME="JMJ Synergie"
APP_VERSION=1.0.0

# PostgreSQL
POSTGRES_DB=jmj
POSTGRES_USER=jmj_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT Security
SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MINIMUM_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1

# CORS
ALLOWED_ORIGINS=https://yourdomain.com
TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Storage
MAX_FILE_SIZE_MB=10

# Email — Brevo (prioritaire) ou SMTP fallback
# ⚠ OBLIGATOIRE : BREVO_SENDER_EMAIL doit correspondre à un domaine vérifié dans Brevo
# Brevo : récupérez votre clé sur https://app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@votre-domaine-verifie.com
BREVO_SENDER_NAME="JMJ Synergie"

# SMTP (utilisé uniquement si BREVO_API_KEY est vide)
# ⚠ SMTP_FROM doit correspondre à votre compte SMTP authentifié
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@yourdomain.com

# Cloudinary (stockage assets logo/cachet/signature + documents scannés)
# Récupérez sur https://console.cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
USE_CLOUDINARY=false

# OCR — Tesseract local (aucune clé API requise)
# L'extraction de factures se fait entièrement en local via Tesseract + OpenCV.
# Aucune donnée n'est envoyée à un service externe.

# Company (PDF headers)
COMPANY_NAME="JMJ Synergie"
COMPANY_ADDRESS="Votre adresse complète"
COMPANY_PHONE="+00 000 000 000"
COMPANY_EMAIL=contact@yourdomain.com
COMPANY_LOGO_PATH=/app/storage/assets/logo.png
COMPANY_STAMP_PATH=/app/storage/assets/stamp.png

# Métriques — protection de l'endpoint /metrics (Prometheus)
# Laisser vide pour restreindre au loopback uniquement (127.0.0.1, ::1)
METRICS_TOKEN=CHANGE_ME_METRICS_SECRET_TOKEN
# IPs autorisées à accéder à /metrics sans Bearer token (CIDR ou IP, séparées par virgule)
# Ex: 10.0.0.5,192.168.1.0/24
METRICS_ALLOWED_IPS=

# CinetPay — Mobile Money (Orange Money, MTN MoMo, Moov Money)
# Récupérez sur https://dashboard.cinetpay.com > API > Mes infos
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id

# Monitoring
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Super Admin initial (seed.py — requis au premier déploiement, supprimer ensuite)
# Minimum 12 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial
SUPER_ADMIN_EMAIL=admin@votre-domaine.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_12CHARS_MIN
SUPER_ADMIN_NAME=Super Administrateur

# ── Dev overrides (docker-compose.dev.yml uniquement) ────────────────────────
# Ports exposés sur la machine hôte (optionnel — valeurs par défaut ci-dessous)
DEV_BACKEND_PORT=8001
DEV_FRONTEND_PORT=3001
# Note : NEXT_PUBLIC_API_URL est forcé à /api/v1 (relatif) par le compose dev.
#        Le frontend Next.js proxifie automatiquement /api/v1/* vers le backend.
